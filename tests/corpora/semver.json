{
  "about": "One corpus for the two deliberate copies of the npm semver subset: doctor's version_matches (crates/doctor/src/lib.rs) and lib/node/semver.nix's satisfies. Both parsers read these cases. expected is true/false for a decision, or null when the parser must reject the input (Rust None, Nix throw). Keep only cases where both copies agree; the few deliberate differences are asserted separately in each copy's unit tests.",
  "cases": [
    { "range": "22", "version": "v22.23.5", "expected": true },
    { "range": "22.14", "version": "v22.14.0", "expected": true },
    { "range": "22.14", "version": "v22.23.5", "expected": false },
    { "range": "22.14.0", "version": "22.14.0", "expected": true },
    { "range": "22.14.0", "version": "v22.14.1", "expected": false },
    { "range": "v22", "version": "v22.23.5", "expected": true },
    { "range": "v24", "version": "v24.11.0", "expected": true },
    { "range": "=22.14.0", "version": "22.14.0", "expected": true },
    { "range": "22.x", "version": "22.23.5", "expected": true },
    { "range": "1.x", "version": "1.2.3", "expected": true },
    { "range": "*", "version": "10.4.1", "expected": true },
    { "range": "^22", "version": "v22.23.5", "expected": true },
    { "range": "^10.2", "version": "10.4.1", "expected": true },
    { "range": "^10.2", "version": "10.1.9", "expected": false },
    { "range": "^10.2", "version": "11.0.0", "expected": false },
    { "range": "^0.2.3", "version": "0.2.9", "expected": true },
    { "range": "^0.2.3", "version": "0.3.0", "expected": false },
    { "range": "^0.0.3", "version": "0.0.4", "expected": false },
    { "range": "^0", "version": "0.9.9", "expected": true },
    { "range": "^0", "version": "1.0.0", "expected": false },
    { "range": "~1.22", "version": "1.22.22", "expected": true },
    { "range": "~1.22.1", "version": "1.23.0", "expected": false },
    { "range": ">=9 <11", "version": "10.4.1", "expected": true },
    { "range": ">=9 <11", "version": "11.0.0", "expected": false },
    { "range": ">= 9 < 11", "version": "9.0.0", "expected": true },
    { "range": ">=18", "version": "20.0.0", "expected": true },
    { "range": ">9", "version": "9.9.9", "expected": false },
    { "range": ">9.1", "version": "9.2.0", "expected": true },
    { "range": "<=10.2", "version": "10.2.7", "expected": true },
    { "range": "<=10.2", "version": "10.3.0", "expected": false },
    { "range": "1.2 - 2", "version": "2.9.0", "expected": true },
    { "range": "1.2 - 2", "version": "3.0.0", "expected": false },
    { "range": "1.2 - 2", "version": "1.1.0", "expected": false },
    { "range": "1.2.3 - 1.2.5", "version": "1.2.4", "expected": true },
    { "range": "8 || 10.x", "version": "10.4.1", "expected": true },
    { "range": "8 || 9", "version": "10.4.1", "expected": false },
    { "range": "22.14.0+build.1", "version": "22.14.0", "expected": true },
    { "range": "lts/*", "version": "v22.23.5", "expected": null },
    { "range": "latest", "version": "10.4.1", "expected": null },
    { "range": "node", "version": "v22.23.5", "expected": null },
    { "range": "^10", "version": "10.0.0-rc.1", "expected": null },
    { "range": "22", "version": "", "expected": null }
  ]
}
